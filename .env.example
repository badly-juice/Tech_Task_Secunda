# ==== Application ====
APP_NAME=payment-service
# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# true — JSON-логи (прод/Docker), false — человекочитаемый консольный вывод (локально)
LOG_JSON=false

# ==== HTTP API ====
# Статический ключ, который клиент обязан передать в заголовке X-API-Key
API_KEY=change-me-super-secret-key

# ==== PostgreSQL ====
# Внутри docker-compose хост = postgres; локально (без Docker) = localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
# Опционально: готовый DSN. Если пусто — собирается из POSTGRES_* выше.
# DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# ==== RabbitMQ ====
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ==== Outbox relay (публикация событий из БД в RabbitMQ) ====
# Период опроса таблицы outbox, секунды
OUTBOX_POLL_INTERVAL=1.0
# Максимальное число записей, публикуемых за одну итерацию
OUTBOX_BATCH_SIZE=100

# ==== Эмуляция платёжного шлюза (consumer) ====
# Длительность "обработки" платежа, секунды
PROCESSING_TIME_MIN=2.0
PROCESSING_TIME_MAX=5.0
# Доля успешных платежей [0..1]
PROCESSING_SUCCESS_RATE=0.9

# ==== Webhook ====
# Таймаут HTTP-запроса на webhook_url, секунды
WEBHOOK_TIMEOUT=10.0
# Retry-политика: 3 попытки, задержка перед n-й повторной попыткой =
# RETRY_BASE_DELAY * RETRY_DELAY_MULTIPLIER ** (n - 1)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_DELAY_MULTIPLIER=2.0
